# Copy to .env and fill in. NEVER commit real values.

# --- Database (local development only) ---
# These feed docker-compose.yml. Development defaults only -- never production
# credentials, and never a production host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace_dev
POSTGRES_PORT=5432

# Must match the values above. The host is bound to 127.0.0.1 by compose, so the
# database is never reachable from the network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_dev?schema=public"

# --- Auth ---
AUTH_SECRET=
AUTH_URL=

# --- AI ---
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5

# --- Payments (sandbox first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --- Storage ---
# Leave unset in development: attachments then use the local filesystem adapter
# (lib/storage/provider.ts), which is refused in production. Setting these before
# the remote adapter exists (M-09) makes the application fail loudly rather than
# silently writing files to a container's disk.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Where the development filesystem adapter keeps its objects.
STORAGE_LOCAL_ROOT=.storage

# --- Notifications ---
EMAIL_API_KEY=
EMAIL_FROM=
SMS_API_KEY=
WHATSAPP_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# Single-connection dev server (scripts/pglite-server.mjs) needs this; omit for real PostgreSQL.
DATABASE_POOL_MAX=10
