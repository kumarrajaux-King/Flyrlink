{
  "name": "ai-agentic-talent-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Agentic Managed Talent Marketplace",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev-server": "node scripts/pglite-server.mjs",
    "db:verify": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
