// AI-Agentic Managed Talent Marketplace — Database Schema
// STEP 03 — Database Architecture
//
// Conventions (approved in STEP 02, confirmed by sign-off):
//   T-03  All money is BigInt minor units + ISO-4217 `currency` CHAR(3). Never Float/Decimal.
//   T-04  All primary keys are UUIDv7 (`@default(uuid(7))`) — non-enumerable, time-sortable.
//   A-01  One unified Project spine; `Project.source` preserves the entry flow semantics.
//
// Append-only tables (never UPDATEd — corrections are compensating entries):
//   LedgerEntry, AuditLog, PaymentAttempt, WebhookEvent(payload), AiRun, AiAction
//
// See docs/STEP-03-DATABASE-ARCHITECTURE.md for rationale, indexes and constraints.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

